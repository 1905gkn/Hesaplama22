{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/vercel-git-build.sh && node scripts/patch-mekik-front-visual-clear-v1.mjs && node scripts/patch-dist-version-badge-position-v1.mjs",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/server/index.js",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}